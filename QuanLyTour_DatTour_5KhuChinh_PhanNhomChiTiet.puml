      + getDonGiaCoBan(): double
      + capNhatThongTinChung(tenTour: String, diemKhoiHanh: String, diemDen: String, soNgay: int, donGiaCoBan: double): boolean
      + {abstract} tinhGiaVe(): double
      + {abstract} chuyenThanhDong(): String
      + {abstract} docTuDong(dong: String): boolean
    }

  class TourTrongNuoc {
      - vungMien: String
      - phuPhi: double
      + TourTrongNuoc()
