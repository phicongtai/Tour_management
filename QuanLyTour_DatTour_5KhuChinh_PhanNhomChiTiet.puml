  class TourNuocNgoai {
      - quocGia: String
      - canVisa: boolean
      - phiVisa: double
      + TourNuocNgoai()
      + TourNuocNgoai(maTour: int, tenTour: String, diemKhoiHanh: String, diemDen: String, soNgay: int, donGiaCoBan: double, quocGia: String, canVisa: boolean, phiVisa: double)
      + getQuocGia(): String
      + getCanVisa(): boolean
      + getPhiVisa(): double
      + capNhatThongTinRieng(quocGia: String, canVisa: boolean, phiVisa: double): boolean
      + tinhGiaVe(): double
      + chuyenThanhDong(): String
      + docTuDong(dong: String): boolean
    }

  class DanhSachTour {
      - danhSach: Tour[]
      - soLuong: int
      - danhSachTam: Tour[]
      - soLuongTam: int
      + them(tour: Tour): boolean
      + timTheoMa(maTour: int): Tour
      + timTheoTuKhoa(tuKhoa: String): Tour[]
      + timTheoDiemDen(diemDen: String): Tour[]
      + timTheoKhoangGia(giaTu: double, giaDen: double): Tour[]
      + timTheoSoNgay(soNgay: int): Tour[]
      + xoaTheoMa(maTour: int): boolean
      + layTatCa(): Tour[]
      + getSoLuong(): int
      + layLoaiDuLieu(): String[]
      + chuyenThanhCacDong(): String[]
      + chuanBiNhap(toanBoCacDong: String[]): boolean
      + xacNhanNhap(): int
      + huyNhapTam(): void
    }

}

