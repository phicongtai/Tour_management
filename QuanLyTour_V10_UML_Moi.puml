' 4. ĐẶT VÉ VÀ THANH TOÁN — KHÔNG CÓ LỚP ĐƠN ĐẶT TOUR
' ============================================================
package "datvevathanhtoan" #F3ECFB {
  class Ve {
    {static} DA_DAT: int = 0
    {static} DA_THANH_TOAN: int = 1
    {static} DA_HUY: int = 2
    --
    - maVe: int
    - maDonDatTour: int
    - maNguoiDat: int
    - maKeHoachTour: int
    - maHanhKhach: int
    - ngayDat: String
    - donGia: long
    - trangThai: int
    --
    + chiemCho(): boolean
    + duocHuy(): boolean
    + capNhatTrangThai(trangThaiMoi: int): boolean
  }

  note right of Ve
    Không tạo đối tượng DonDatTour.
    maDonDatTour chỉ là mã nhóm vé dùng để:
    - gom vé cùng một lần đặt;
    - truy vấn nhóm vé và hóa đơn;
    - xác nhận/hủy nhóm vé.
    Trạng thái nhóm được suy ra từ trạng thái các vé.
  end note

  class DanhSachVe {
    - danhSach: Ve[]
    - soLuong: int
    --
    + them(ve: Ve): boolean
    + timTheoMa(maVe: int): Ve
    + timTheoMaDonDatTour(maDonDatTour: int): Ve[]
    + layDanhSachMaDonDatTour(): int[]
    + demVeTheoMaDonDatTour(maDonDatTour: int): int
    + timTheoNguoiDat(maNguoiDat: int): Ve[]
    + timTheoHanhKhach(maHanhKhach: int): Ve[]
    + timTheoKeHoach(maKeHoachTour: int): Ve[]
    + timTheoTrangThai(trangThai: int): Ve[]
    + demVeChiemChoTheoKeHoach(maKeHoachTour: int): int
    + daCoVeHopLe(maKeHoachTour: int, maHanhKhach: int): boolean
    + capNhat(ve: Ve): boolean
    + layTatCa(): Ve[]
    + xuatDuLieu(): String[]
    + nhapDuLieu(dongDuLieu: String[]): boolean
  }

  class ChiTietHoaDon {
    - maHoaDon: int
    - danhSachMaVe: int[]
    - soLuongVe: int
    - tongTien: long
    --
    + ChiTietHoaDon(maHoaDon: int)
    + themVe(maVe: int): boolean
    + coChuaVe(maVe: int): boolean
    + layDanhSachMaVe(): int[]
    + demSoVe(): int
    + capNhatTongTien(dsVe: DanhSachVe): boolean
    + tinhTongTien(dsVe: DanhSachVe): long
    + layTongTien(): long
  }

  class HoaDon {
    - maHoaDon: int
    - maDonDatTour: int
    - maNhanVien: int
    - ngayLap: String
    - soTienDaThanhToan: long
    - chiTiet: ChiTietHoaDon
    --
    + HoaDon(maHoaDon: int, maDonDatTour: int, maNhanVien: int, ngayLap: String)
    + themVeVaoChiTiet(maVe: int, dsVe: DanhSachVe): boolean
    + layDanhSachMaVe(): int[]
    + demSoVe(): int
    + tinhTongTien(): long
    + tinhSoTienConLai(): long
    + ghiNhanThanhToan(soTien: long): boolean
    + daThanhToanDu(): boolean
    + coTheHuyHoanTien(): boolean
  }

  note right of ChiTietHoaDon
    Trong thiết kế này, một ChiTietHoaDon đại diện
    cho toàn bộ danh sách vé của một hóa đơn.

    - maHoaDon: mã hóa đơn sở hữu nhóm chi tiết.
    - danhSachMaVe: các mã vé thuộc hóa đơn.
    - soLuongVe: số phần tử mã vé đang sử dụng.
    - tongTien: tổng giá của các vé trong danh sách,
      không phải đơn giá của một vé.

    DanhSachVe là nơi lưu đối tượng Ve thực tế.
    ChiTietHoaDon chỉ giữ mã vé và tra cứu Ve qua
    DanhSachVe khi lập hóa đơn để tính tổng tiền.
    HoaDon tạo ChiTietHoaDon với đúng maHoaDon.
    Sau khi hóa đơn được lập, danh sách vé và tổng tiền
    là dữ liệu lịch sử; không tự tính lại khi hiển thị.

    Khi lập hóa đơn, HoaDon.themVeVaoChiTiet kiểm tra:
    - Mã vé tồn tại.
    - Vé thuộc đúng maDonDatTour của hóa đơn.
    - Vé chưa xuất hiện trong chi tiết.
    - Vé chưa được gán vào hóa đơn khác.

    Sau khi lập hóa đơn, không sửa/xóa mã vé để thay
    đổi lịch sử. Hủy/hoàn tiền xử lý trạng thái vé và
    nghiệp vụ hoàn tiền riêng; giữ nguyên tổng tiền gốc.
  end note

  class DanhSachHoaDon {
    - danhSach: HoaDon[]
    - soLuong: int
    --
    + them(hoaDon: HoaDon): boolean
    + timTheoMa(maHoaDon: int): HoaDon
    + timTheoMaDonDatTour(maDonDatTour: int): HoaDon
    + timChuaThanhToanDu(): HoaDon[]
    + capNhat(hoaDon: HoaDon): boolean
    + layTatCa(): HoaDon[]
    + xuatDuLieu(): String[]
    + nhapDuLieu(dongDuLieu: String[]): boolean
  }

  DanhSachVe o--> "0..*" Ve : quản lý vé
  DanhSachHoaDon o--> "0..*" HoaDon : quản lý hóa đơn
  HoaDon *--> "1" ChiTietHoaDon : sở hữu danh sách vé
  ChiTietHoaDon ..> DanhSachVe : tra cứu mã vé và giá vé
  HoaDon ..> DanhSachVe : xác thực vé khi lập hóa đơn
}

