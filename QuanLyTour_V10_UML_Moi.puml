    + timTheoMa(maTour: int): Tour
    + timTheoTuKhoa(tuKhoa: String): Tour[]
    + timTheoDiemDen(diemDen: String): Tour[]
    + timTheoKhoangGia(giaTu: long, giaDen: long): Tour[]
    + timTheoSoNgay(soNgay: int): Tour[]
